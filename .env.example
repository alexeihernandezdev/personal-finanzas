DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
# Conexión directa (sin pooler) para migraciones. Si no se define, se usa DATABASE_URL.
DIRECT_URL=""
AUTH_SECRET="genera-uno-con: npx auth secret"
CRON_SECRET="token-largo-aleatorio"
# Opcional: login con Google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Importar movimientos desde capturas (LlamaExtract de LlamaCloud)
LLAMA_CLOUD_API_KEY=""
# Opcional: proyecto de LlamaCloud (si no, el proyecto por defecto)
LLAMA_CLOUD_PROJECT_ID=""
# Las capturas se suben directo del navegador a Cloudinary y se borran tras leerlas
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
