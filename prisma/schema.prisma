generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuarios ────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  name                String?
  email               String     @unique
  passwordHash        String?
  image               String?
  displayCurrency     String     @default("USD")
  preferredRateSource RateSource @default(BCV)
  // Cómo se muestran los movimientos: "USD" (convertidos) u "ORIGINAL" (divisa de la cuenta)
  movementsCurrency   String     @default("USD")
  // Tasa con la que se convierten los movimientos para mostrarlos (la del día del movimiento)
  movementsRateSource RateSource @default(BCV)
  // Colchón sobre los gastos fijos (% de su total) para cubrir extras e imprevistos
  fixedBufferPercent  Decimal    @default(0) @db.Decimal(5, 2)
  createdAt           DateTime   @default(now())

  wallets          Wallet[]
  categories       Category[]
  businesses       Business[]
  transactions     Transaction[]
  recurringExpense RecurringExpense[]
  recurringIncome  RecurringIncome[]
  receivables      Receivable[]
  debts            Debt[]
  pockets          Pocket[]
  ownerPays        OwnerPay[]
}

// ─── Catálogos ───────────────────────────────────────────────────────────────

model Currency {
  code     String @id // USD, VES, USDT…
  name     String
  symbol   String
  decimals Int    @default(2)

  wallets Wallet[]
}

enum WalletType {
  BANK
  PAYPAL
  BINANCE
  CASH
  OTHER
}

model Wallet {
  id             String     @id @default(cuid())
  userId         String
  name           String
  type           WalletType @default(BANK)
  currencyCode   String
  initialBalance Decimal    @default(0) @db.Decimal(20, 8)
  color          String     @default("#64748b")
  archived       Boolean    @default(false)
  createdAt      DateTime   @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency        Currency           @relation(fields: [currencyCode], references: [code])
  transactions    Transaction[]
  recurring       RecurringExpense[]
  recurringIncome RecurringIncome[]

  @@index([userId])
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id       String       @id @default(cuid())
  userId   String
  name     String
  kind     CategoryKind
  color    String       @default("#64748b")
  archived Boolean      @default(false)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurring       RecurringExpense[]
  recurringIncome RecurringIncome[]

  @@unique([userId, kind, name])
}

model Business {
  id       String  @id @default(cuid())
  userId   String
  name     String
  color    String  @default("#6366f1")
  archived Boolean @default(false)
  // Tu sueldo: un monto fijo al mes o un % de la ganancia del mes (ingresos − gastos)
  ownerPayMode    OwnerPayMode @default(NONE)
  ownerPayPercent Decimal?     @db.Decimal(5, 2)
  // Sueldo fijo, en `ownerPayCurrency`: cuenta como gasto fijo del negocio e ingreso fijo Personal
  ownerPayAmount   Decimal? @db.Decimal(20, 8)
  ownerPayCurrency String?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurring       RecurringExpense[]
  recurringIncome RecurringIncome[]
  receivables     Receivable[]
  debts           Debt[]
  pockets         Pocket[]
  ownerPays       OwnerPay[]

  @@unique([userId, name])
}

enum OwnerPayMode {
  NONE
  FIXED // monto fijo al mes
  PROFIT_PERCENT // % de la ganancia del mes
}

// Sueldo de un mes que te pagaste de un negocio: un traspaso de sus apartados a la Caja Personal
model OwnerPay {
  id           String   @id @default(cuid())
  userId       String
  businessId   String
  month        String // yyyy-mm
  amount       Decimal  @db.Decimal(20, 8)
  currencyCode String
  // Movimientos de apartados del traspaso
  groupId      String
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, month])
}

// ─── Movimientos ─────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_OUT
  TRANSFER_IN
  LOAN_OUT
  LOAN_REPAYMENT
  LOAN_IN // préstamo recibido: entra dinero que debo
  DEBT_PAYMENT // pago de un préstamo recibido: sale dinero, no es gasto
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum RateSource {
  BCV
  BINANCE
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  walletId        String
  type            TransactionType
  amount          Decimal         @db.Decimal(20, 8) // siempre positivo; el signo lo da `type`
  date            DateTime        @db.Date
  description     String          @default("")
  categoryId      String?
  // Dueño del movimiento: null = Personal
  businessId      String?
  transferGroupId String?
  receivableId    String?
  debtId          String?
  recurringId     String?
  // Snapshot de la tasa (VES por USD) al momento del movimiento
  rateVesPerUsd   Decimal?        @db.Decimal(20, 8)
  rateSource      RateSource?
  createdAt       DateTime        @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  business        Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  receivable      Receivable?        @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  debt            Debt?              @relation(fields: [debtId], references: [id], onDelete: SetNull)
  recurring       RecurringExpense?  @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  pocketMovements PocketMovement[]

  @@index([userId, date])
  @@index([walletId])
  @@index([businessId])
  @@index([transferGroupId])
  @@index([recurringId, date])
}

// ─── Gastos fijos ────────────────────────────────────────────────────────────

model RecurringExpense {
  id           String   @id @default(cuid())
  userId       String
  name         String
  amount       Decimal  @db.Decimal(20, 8)
  currencyCode String
  dayOfMonth   Int
  // Cada cuántos meses se paga (1 = mensual, 3 = trimestral, 6 = semestral, 12 = anual)
  intervalMonths Int     @default(1)
  // Mes (yyyy-mm) de un pago, que fija en qué meses vence; null = todos los meses
  startMonth     String?
  walletId     String?
  categoryId   String?
  businessId   String?
  active       Boolean  @default(true)
  // Se cobra solo (domiciliado): el pago se registra automáticamente el día del vencimiento
  autoPay      Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?             @relation(fields: [walletId], references: [id], onDelete: SetNull)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  business     Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  paidMarks    RecurringPaidMark[]

  @@index([userId])
}

// Mes marcado como pagado sin registrar un movimiento (p. ej. ya estaba registrado aparte)
model RecurringPaidMark {
  id          String   @id @default(cuid())
  recurringId String
  month       String // yyyy-mm
  date        DateTime @db.Date
  createdAt   DateTime @default(now())

  recurring RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, month])
}

// ─── Ingresos fijos ──────────────────────────────────────────────────────────

model RecurringIncome {
  id           String   @id @default(cuid())
  userId       String
  name         String
  amount       Decimal  @db.Decimal(20, 8)
  currencyCode String
  dayOfMonth   Int
  // Cada cuántos meses se cobra (1 = mensual, 3, 6, 12) y un mes (yyyy-mm) en que toca; null = todos
  intervalMonths Int     @default(1)
  startMonth     String?
  walletId     String?
  categoryId   String?
  businessId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── Por cobrar / préstamos ──────────────────────────────────────────────────

enum ReceivableKind {
  RECEIVABLE
  LOAN_GIVEN
}

enum ReceivableStatus {
  PENDING
  PARTIAL
  SETTLED
  CANCELLED
}

model Receivable {
  id           String           @id @default(cuid())
  userId       String
  kind         ReceivableKind
  counterparty String
  description  String           @default("")
  amount       Decimal          @db.Decimal(20, 8)
  currencyCode String
  expectedDate DateTime?        @db.Date
  businessId   String?
  status       ReceivableStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, status])
}

// ─── Deudas (lo que yo debo) ─────────────────────────────────────────────────

enum DebtKind {
  PAYABLE // le debo a alguien (compra a crédito, factura pendiente…)
  LOAN_RECEIVED // me prestaron dinero
}

model Debt {
  id           String           @id @default(cuid())
  userId       String
  kind         DebtKind
  counterparty String
  description  String           @default("")
  amount       Decimal          @db.Decimal(20, 8)
  currencyCode String
  dueDate      DateTime?        @db.Date
  businessId   String?
  status       ReceivableStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, status])
}

// ─── Apartados (cuentas virtuales) ───────────────────────────────────────────
// Separan parte del dinero de las cuentas (ahorro, metas…). El dinero sigue en las cuentas; el
// apartado solo lo marca como "no disponible". Disponible = saldo de las cuentas − apartados.
// Cada dueño (Personal o un negocio) tiene:
// - una Caja (`isMain`): ahí cae su dinero y se queda lo que sobra al repartir;
// - un apartado de Gastos fijos (`isFixedReserve`): se lleva el % que sus gastos fijos son de su
//   ingreso fijo, y de él se pagan;
// - apartados con `percent`: se llevan ese % de cada ingreso (ocio, ahorro, inversión…).

enum PocketKind {
  SAVINGS // ahorro
  GOAL // meta u objetivo
  EMERGENCY // fondo de emergencia
  RESERVE // reserva (impuestos, gastos fijos…)
}

model Pocket {
  id             String     @id @default(cuid())
  userId         String
  currencyCode   String // Divisa del apartado; no está ligado a ninguna cuenta
  name           String
  kind           PocketKind @default(SAVINGS)
  businessId     String? // null = Personal
  targetAmount   Decimal?   @db.Decimal(20, 8) // en la divisa del apartado
  targetDate     DateTime?  @db.Date
  color          String     @default("#0f766e")
  archived       Boolean    @default(false)
  isMain         Boolean    @default(false) // Caja del dueño
  pinned         Boolean    @default(false) // Se muestra en el inicio
  // Reserva de gastos fijos del dueño
  isFixedReserve Boolean    @default(false)
  // % de cada ingreso de su dueño que se aparta aquí; null = solo se llena a mano
  percent        Decimal?   @db.Decimal(5, 2)
  createdAt      DateTime   @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  movements PocketMovement[]

  @@index([userId])
}

model PocketMovement {
  id                  String   @id @default(cuid())
  pocketId            String
  amount              Decimal  @db.Decimal(20, 8) // + apartar, − liberar
  date                DateTime @db.Date
  description         String   @default("")
  // Ingreso del que salió (al repartir un ingreso según el presupuesto)
  sourceTransactionId String?
  // Une los movimientos de una misma operación (ingreso y sus repartos, o un traspaso)
  groupId             String?
  createdAt           DateTime @default(now())

  pocket            Pocket       @relation(fields: [pocketId], references: [id], onDelete: Cascade)
  sourceTransaction Transaction? @relation(fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  @@index([pocketId])
  @@index([sourceTransactionId])
  @@index([groupId])
}

// ─── Tasas de cambio (global) ────────────────────────────────────────────────

enum RateKind {
  BCV
  BINANCE_BUY
  BINANCE_SELL
}

model ExchangeRate {
  id        String   @id @default(cuid())
  kind      RateKind
  rate      Decimal  @db.Decimal(20, 8) // VES por 1 USD (o USDT)
  fetchedAt DateTime @default(now())

  @@index([kind, fetchedAt])
}
